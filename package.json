{
  "name": "nine-tripod-cauldrons",
  "productName": "九鼎",
  "version": "0.1.0",
  "description": "九鼎 · 十日：单机动作肉鸽游戏技术验证工程",
  "private": true,
  "license": "UNLICENSED",
  "author": "Bacsonlx",
  "main": ".webpack/main",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bacsonlx/NineTripodCauldrons.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron-forge start",
