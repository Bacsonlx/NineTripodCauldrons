extends RefCounted
const Journey = preload("res://scripts/journey/room_journey.gd")
const Boss = preload("res://scripts/combat/boss_room.gd")
func run(check: Callable) -> void:
	var helper = load("res://tests/skill_resource_checks.gd").new()
	var data: Dictionary = helper.fixture("entry","other")
	data.objective="combat"; data.encounters=[{"x":400,"y":600,"enemies":[{"x":455,"y":600,"appearance":"bird"}]}]
	var ordinary = Journey.new({"entry":data,"other":helper.fixture("other","entry")},{"health":20})
	helper.configure(ordinary,"蓄势")
	ordinary.update({"special1":true},0); ordinary.update({"beast":true,"moveX":1},0.01)
	PlayerControls.new(ordinary.active).interrupt()
	ordinary.update({},0.7)
	check.call(ordinary.snapshot().status=="failed" and ordinary.snapshot().health==0,"普通敌真实致死，形成阵亡局末")
	check.call(ordinary.snapshot().charge.layers==0 and ordinary.snapshot().charge.remaining==0 and ordinary.snapshot().windPath.is_empty() and not ordinary.snapshot().windExtraReady,"普通敌阵亡清蓄势、风道及追加资格")
	var boss_data: Dictionary = Boss.arena_layout()
	boss_data.roomId="entry"; boss_data.mode="gameplay"; boss_data.health=20; boss_data.spawn=Vector2(600,520)
	var fatal: TrainingRoom = Boss.new(boss_data)
	helper.configure(fatal,"蓄势")
	fatal.update({"special1":true},0); fatal.update({"beast":true,"moveX":1},0.01)
	PlayerControls.new(fatal).interrupt(); fatal.update({},2.1)
	check.call(fatal.snapshot().status=="failed" and fatal.snapshot().health==0,"索尔横锤实际致死，不改写失败状态")
	check.call(fatal.snapshot().charge.layers==0 and fatal.snapshot().charge.remaining==0 and fatal.snapshot().windPath.is_empty() and not fatal.snapshot().windExtraReady,"索尔阵亡分支同样清全部即时技能效果")
	boss_data.health=100
	var normal: TrainingRoom = Boss.new(boss_data)
	helper.configure(normal,"蓄势")
	normal.update({"special1":true},0); normal.update({"fire":true,"aim":Vector2(720,468)},0.25)
	check.call(normal.snapshot().boss.health==1177 and normal.snapshot().charge.layers==1,"蓄势直接普攻对索尔15×1.5最终取整23，离弦只消一层")
	boss_data.spawn=Vector2(300,520); boss_data.boss=Vector2(1000,520)
	var opening: TrainingRoom = Boss.new(boss_data)
	helper.configure(opening,"蓄势")
	load("res://tests/boss_checks.gd").new().advance_until(opening,"flight")
	check.call(opening.snapshot().vulnerable,"真实招式进入离手破绽")
	opening.update({"special1":true},0); opening.update({"fire":true,"aim":Vector2(720,468)},0.1)
	opening.update({"aim":Vector2(720,468)},0.6)
	check.call(opening.snapshot().boss.health==1172 and opening.snapshot().charge.layers==1,"蓄势与索尔25%破绽相乘后最终一次取整28")
