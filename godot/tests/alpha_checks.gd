extends RefCounted

const Room = preload("res://scripts/combat/training_room.gd")

func run(check: Callable) -> void:
	var room: TrainingRoom = Room.new({"mode":"alpha"})
	check.call(room.snapshot().get("alpha",{}).get("camp",false), "初版从安全营地开始并公开构筑状态")

	var drop: Dictionary = room.snapshot().alpha.items.back()
	room.update({"alpha":{"action":"pickup","id":drop.id}},0)
	var picked: Dictionary = room.snapshot().alpha.items.back()
	check.call(picked.region=="warehouse" and picked.rotated, "两格实物在一行仓库自动旋转入仓，实例不复制")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(6,0),"rotated":false}},0)
	check.call(room.snapshot().alpha.items.back().cell==Vector2i(6,0), "营地可把实物旋转放入祭坛")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(9,3)}},0)
	check.call(room.snapshot().alpha.items.back().cell==Vector2i(6,0) and room.snapshot().alpha.message.contains("跨区"), "跨区拒绝后保留原物与原位置")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(0,0)}},0)
	check.call(room.snapshot().alpha.message.contains("占用"), "与训练弓重叠被拒绝并给出原因")
	room.update({"moveX":1,"fire":true},3)
	check.call(room.snapshot().player.x==400 and room.snapshot().alpha.elapsed==0 and room.snapshot().shots==0, "营地冻结规则时间、移动和攻击")
	room.update({"alpha":{"action":"depart"}},0)
	room.update({"moveX":1},0.1)
	check.call(is_equal_approx(room.snapshot().player.x,422) and room.snapshot().alpha.elapsed>0, "出发后沿用后羿每秒220的既有移动")
	var blocked: TrainingRoom = Room.new({"mode":"alpha","obstacle":Rect2(425,580,10,40)})
	blocked.update({"alpha":{"action":"pickup","id":blocked.snapshot().alpha.items.back().id}},0)
	check.call(blocked.snapshot().alpha.items.back().region=="ground" and blocked.snapshot().alpha.message.contains("遮挡"), "80半径内隔墙实物仍留地")

	var altar: TrainingRoom = Room.new({"mode":"alpha"})
	check.call(altar.snapshot().alpha.get("votes",{}).size()==10, "祭坛公开十容器票数且空坛不显灵")

	var wood_id: int = sample(altar,"素食",Vector2i(6,1))
	check.call(altar.snapshot().alpha.votes["木"]==2 and altar.snapshot().alpha.winner=="木", "真实青龙气息触及一格，整件素食只加权一次")
	sample(altar,"快马",Vector2i(7,1))
	check.call(altar.snapshot().alpha.votes["木"]==1 and altar.snapshot().alpha.votes["雷"]==0, "两格物品多条接触边只对冲一次，票数最低零")
	var first: TrainingRoom = Room.new({"mode":"alpha"})
	sample(first,"白盒·木",Vector2i(6,0),{"weighted":true})
	check.call(first.snapshot().alpha.votes["木"]==3, "残一票乘气息2再乘1.5，最后统一取整得到3")
	sample(first,"白盒·火",Vector2i(9,2),{"quality":"珍"})
	check.call(first.snapshot().alpha.winner=="木" and first.snapshot().alpha.harm=="雷", "最高并列保留原显灵，对冲作祟而非并列另一方")
	first.update({"alpha":{"action":"place","id":first.snapshot().alpha.items.back().id,"cell":Vector2i(8,2)}},0)
	check.call(first.snapshot().alpha.winner=="木", "同坛挪位不洗掉入坛历史")
	var second: TrainingRoom = Room.new({"mode":"alpha"})
	sample(second,"白盒·金",Vector2i(8,0),{"quality":"异"})
	sample(second,"白盒·水",Vector2i(8,2))
	sample(second,"白盒·土",Vector2i(6,3))
	check.call(second.snapshot().alpha.winner=="金" and second.snapshot().alpha.harm=="水", "唯一第一下第二名同票保留原作祟")
	for pair in [["金","火"],["木","雷"],["水","土"],["塔","场"],["草","镜"]]:
		var zero: TrainingRoom = Room.new({"mode":"alpha"})
		sample(zero,"白盒·"+pair[0],Vector2i(8,0))
		sample(zero,"白盒·"+pair[1],Vector2i(9,0))
		check.call(zero.snapshot().alpha.winner=="" and zero.snapshot().alpha.harm=="" and zero.snapshot().alpha.breakdown[0].eligible, pair[0]+pair[1]+"正交对冲至零仍有资格，全零停止身份")
	var invalid_vote: TrainingRoom = Room.new({"mode":"alpha"})
	sample(invalid_vote,"白盒·金",Vector2i(8,0),{"eligible":false})
	check.call(not invalid_vote.snapshot().alpha.breakdown[0].eligible and invalid_vote.snapshot().alpha.votes["金"]==0, "无资格与合格零票在公开结果中明确区分")
	check.call(altar.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==wood_id).size()==1, "反复读取票数不生成新物品或改写实例")

	var seal: TrainingRoom = Room.new({"mode":"alpha"})
	var book: int = sample(seal,"穿透箭",Vector2i(6,0))
	sample(seal,"司晨",Vector2i(9,2))
	check.call(seal.snapshot().alpha.harm=="金" and seal.snapshot().alpha.sealed.size()==2 and seal.snapshot().alpha.breakdown[0].eligible==false, "金补位封两格，已有技能书仍占格且不投票")
	sample(seal,"白盒·土",Vector2i(7,0))
	check.call(seal.snapshot().alpha.items.back().region=="warehouse" and seal.snapshot().alpha.message.contains("封格"), "封格仅禁止新物进入，失败实物留仓")
	seal.update({"alpha":{"action":"place","id":book,"cell":Vector2i(6,1)}},0)
	check.call(seal.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==book)[0].cell==Vector2i(6,1), "封格内已有物可以移出，不会因封格失效循环")

	var equipment: TrainingRoom = Room.new({"mode":"alpha"})
	sample(equipment,"白盒装备·金",Vector2i(8,0),{"quality":"神","mainGlyph":true})
	check.call(equipment.snapshot().alpha.votes["金"]==3, "神品装备只按唯一主符归属投三票")
	var no_glyph: TrainingRoom = Room.new({"mode":"alpha"})
	sample(no_glyph,"白盒装备·金",Vector2i(8,0),{"quality":"专属","mainGlyph":false})
	check.call(no_glyph.snapshot().alpha.votes["金"]==0, "无主符装备上坛不投票")
	var history: TrainingRoom = Room.new({"mode":"alpha"})
	sample(history,"白盒·木",Vector2i(8,0),{"eligible":false})
	var leading: int = sample(history,"白盒·金",Vector2i(8,2),{"quality":"异"})
	sample(history,"白盒·火",Vector2i(9,0))
	sample(history,"白盒·木",Vector2i(8,3))
	history.update({"alpha":{"action":"place","id":leading,"cell":Vector2i(6,4)}},0)
	check.call(history.snapshot().alpha.winner=="木", "原第一退出后最高并列按仍留坛最早物品归属，资格只限定第二名裁决")

func sample(room: TrainingRoom, title: String, cell: Vector2i, configuration: Dictionary = {}) -> int:
	var intent: Dictionary = {"action":"sample","name":title}
	intent.merge(configuration)
	room.update({"alpha":intent},0)
	var id: int = room.snapshot().alpha.items.back().id
	room.update({"alpha":{"action":"pickup","id":id}},0)
	room.update({"alpha":{"action":"place","id":id,"cell":cell,"rotated":false}},0)
	return id
