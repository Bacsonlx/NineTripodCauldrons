extends RefCounted

const Room = preload("res://scripts/combat/training_room.gd")

func run(check: Callable) -> void:
	var room: TrainingRoom = Room.new({"mode":"alpha"})
	check.call(room.snapshot().get("alpha",{}).get("camp",false), "初版从安全营地开始并公开构筑状态")

	var drop: Dictionary = room.snapshot().alpha.items.back()
	room.update({"alpha":{"action":"pickup","id":drop.id}},0)
	var picked: Dictionary = room.snapshot().alpha.items.back()
	check.call(picked.region=="warehouse" and picked.rotated, "两格实物在一行仓库自动旋转入仓，实例不复制")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(6,0),"rotated":false}},0)
	check.call(room.snapshot().alpha.items.back().cell==Vector2i(6,0), "营地可把实物旋转放入祭坛")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(9,3)}},0)
	check.call(room.snapshot().alpha.items.back().cell==Vector2i(6,0) and room.snapshot().alpha.message.contains("跨区"), "跨区拒绝后保留原物与原位置")
	room.update({"alpha":{"action":"place","id":drop.id,"cell":Vector2i(0,0)}},0)
	check.call(room.snapshot().alpha.message.contains("占用"), "与训练弓重叠被拒绝并给出原因")
	room.update({"moveX":1,"fire":true},3)
	check.call(room.snapshot().player.x==400 and room.snapshot().alpha.elapsed==0 and room.snapshot().shots==0, "营地冻结规则时间、移动和攻击")
	room.update({"alpha":{"action":"depart"}},0)
	room.update({"moveX":1},0.1)
	check.call(is_equal_approx(room.snapshot().player.x,422) and room.snapshot().alpha.elapsed>0, "出发后沿用后羿每秒220的既有移动")
	var blocked: TrainingRoom = Room.new({"mode":"alpha","obstacle":Rect2(425,580,10,40)})
	blocked.update({"alpha":{"action":"pickup","id":blocked.snapshot().alpha.items.back().id}},0)
	check.call(blocked.snapshot().alpha.items.back().region=="ground" and blocked.snapshot().alpha.message.contains("遮挡"), "80半径内隔墙实物仍留地")

	var altar: TrainingRoom = Room.new({"mode":"alpha"})
	check.call(altar.snapshot().alpha.get("votes",{}).size()==10, "祭坛公开十容器票数且空坛不显灵")

	var wood_id: int = sample(altar,"素食",Vector2i(6,1))
	check.call(altar.snapshot().alpha.votes["木"]==2 and altar.snapshot().alpha.winner=="木", "真实青龙气息触及一格，整件素食只加权一次")
	sample(altar,"快马",Vector2i(7,1))
	check.call(altar.snapshot().alpha.votes["木"]==1 and altar.snapshot().alpha.votes["雷"]==0, "两格物品多条接触边只对冲一次，票数最低零")
	var first: TrainingRoom = Room.new({"mode":"alpha"})
	sample(first,"白盒·木",Vector2i(6,0),{"weighted":true})
	check.call(first.snapshot().alpha.votes["木"]==3, "残一票乘气息2再乘1.5，最后统一取整得到3")
	sample(first,"白盒·火",Vector2i(9,2),{"quality":"珍"})
	check.call(first.snapshot().alpha.winner=="木" and first.snapshot().alpha.harm=="雷", "最高并列保留原显灵，对冲作祟而非并列另一方")
	first.update({"alpha":{"action":"place","id":first.snapshot().alpha.items.back().id,"cell":Vector2i(8,2)}},0)
	check.call(first.snapshot().alpha.winner=="木", "同坛挪位不洗掉入坛历史")
	var second: TrainingRoom = Room.new({"mode":"alpha"})
	sample(second,"白盒·金",Vector2i(8,0),{"quality":"异"})
	sample(second,"白盒·水",Vector2i(8,2))
	sample(second,"白盒·土",Vector2i(6,3))
	check.call(second.snapshot().alpha.winner=="金" and second.snapshot().alpha.harm=="水", "唯一第一下第二名同票保留原作祟")
	for pair in [["金","火"],["木","雷"],["水","土"],["塔","场"],["草","镜"]]:
		var zero: TrainingRoom = Room.new({"mode":"alpha"})
		sample(zero,"白盒·"+pair[0],Vector2i(8,0))
		sample(zero,"白盒·"+pair[1],Vector2i(9,0))
		check.call(zero.snapshot().alpha.winner=="" and zero.snapshot().alpha.harm=="" and zero.snapshot().alpha.breakdown[0].eligible, pair[0]+pair[1]+"正交对冲至零仍有资格，全零停止身份")
	var invalid_vote: TrainingRoom = Room.new({"mode":"alpha"})
	sample(invalid_vote,"白盒·金",Vector2i(8,0),{"eligible":false})
	check.call(not invalid_vote.snapshot().alpha.breakdown[0].eligible and invalid_vote.snapshot().alpha.votes["金"]==0, "无资格与合格零票在公开结果中明确区分")
	check.call(altar.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==wood_id).size()==1, "反复读取票数不生成新物品或改写实例")

	var seal: TrainingRoom = Room.new({"mode":"alpha"})
	var book: int = sample(seal,"穿透箭",Vector2i(6,0))
	sample(seal,"司晨",Vector2i(9,2))
	check.call(seal.snapshot().alpha.harm=="金" and seal.snapshot().alpha.sealed.size()==2 and seal.snapshot().alpha.breakdown[0].eligible==false, "金补位封两格，已有技能书仍占格且不投票")
	sample(seal,"白盒·土",Vector2i(7,0))
	check.call(seal.snapshot().alpha.items.back().region=="warehouse" and seal.snapshot().alpha.message.contains("封格"), "封格仅禁止新物进入，失败实物留仓")
	seal.update({"alpha":{"action":"place","id":book,"cell":Vector2i(6,1)}},0)
	check.call(seal.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==book)[0].cell==Vector2i(6,1), "封格内已有物可以移出，不会因封格失效循环")

	var equipment: TrainingRoom = Room.new({"mode":"alpha"})
	sample(equipment,"白盒装备·金",Vector2i(8,0),{"quality":"神","mainGlyph":true})
	check.call(equipment.snapshot().alpha.votes["金"]==3, "神品装备只按唯一主符归属投三票")
	var no_glyph: TrainingRoom = Room.new({"mode":"alpha"})
	sample(no_glyph,"白盒装备·金",Vector2i(8,0),{"quality":"专属","mainGlyph":false})
	check.call(no_glyph.snapshot().alpha.votes["金"]==0, "无主符装备上坛不投票")
	var history: TrainingRoom = Room.new({"mode":"alpha"})
	sample(history,"白盒·木",Vector2i(8,0),{"eligible":false})
	var leading: int = sample(history,"白盒·金",Vector2i(8,2),{"quality":"异"})
	sample(history,"白盒·火",Vector2i(9,0))
	sample(history,"白盒·木",Vector2i(8,3))
	history.update({"alpha":{"action":"place","id":leading,"cell":Vector2i(6,4)}},0)
	check.call(history.snapshot().alpha.winner=="木", "原第一退出后最高并列按仍留坛最早物品归属，资格只限定第二名裁决")

	var burning: TrainingRoom = Room.new({"mode":"alpha"})
	sample(burning,"白盒·木",Vector2i(6,1))
	burning.update({"burn":true},0)
	check.call(burning.snapshot().alpha.get("burn",{}).get("container","")=="木" and burning.snapshot().alpha.votes["木"]==0, "点燃立即停票并公开20秒占格状态")

	burning.update({"alpha":{"action":"place","id":burning.snapshot().alpha.items.back().id,"cell":Vector2i(8,0)}},0)
	check.call(burning.snapshot().alpha.items.back().cell==Vector2i(6,1), "燃烧物不能移动，持续占原格")
	burning.update({},25)
	check.call(burning.snapshot().alpha.burn.remaining==20, "营地冻结点燃计时，不免费结算周期")
	burning.update({"alpha":{"action":"depart"}},0)
	burning.update({},20)
	check.call(burning.snapshot().alpha.burn.is_empty() and burning.snapshot().alpha.lastBurn.ticks==[5.0,10.0,15.0,20.0] and burning.snapshot().alpha.items.back().state=="ash", "第20秒先记最后周期再收灰，原形入仓")
	var full: TrainingRoom = Room.new({"mode":"alpha"})
	sample(full,"白盒·土",Vector2i(8,0))
	for title in ["快马","司晨"]:
		full.update({"alpha":{"action":"sample","name":title}},0)
		full.update({"alpha":{"action":"pickup","id":full.snapshot().alpha.items.back().id}},0)
	full.update({"burn":true},0)
	full.update({"alpha":{"action":"depart"}},0)
	full.update({},20)
	var ash: Dictionary = full.snapshot().alpha.items.filter(func(item: Dictionary): return item.state=="ash")[0]
	check.call(ash.region=="ground" and ash.size==Vector2i.ONE, "满仓时灰烬留地且保留原形，不挤旧物")
	full.update({"alpha":{"action":"discard","id":ash.id}},0)
	check.call(full.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==ash.id).is_empty(), "灰烬可丢弃且不能恢复实物")
	var locked: TrainingRoom = Room.new({"mode":"alpha"})
	var locked_id: int = sample(locked,"白盒·火",Vector2i(8,0))
	locked.update({"alpha":{"action":"fixture_lock","id":locked_id}},0)
	locked.update({"burn":true},0)
	check.call(locked.snapshot().alpha.burn.is_empty() and locked.snapshot().alpha.items.back().state=="normal", "一件锁物拒绝整容器点燃且不消耗")
	var short: TrainingRoom = Room.new({"mode":"alpha"})
	sample(short,"白盒·木",Vector2i(6,1))
	short.update({"burn":true},0)
	short.update({"alpha":{"action":"depart"}},0)
	for i in 200: short.update({},0.1)
	check.call(short.snapshot().alpha.lastBurn.ticks==burning.snapshot().alpha.lastBurn.ticks and short.snapshot().alpha.burn.is_empty(), "短步和长帧的点燃结束与最后周期一致")
	var paused_burn: TrainingRoom = Room.new({"mode":"alpha"})
	var input_controls: RefCounted = load("res://scripts/input/player_controls.gd").new(paused_burn)
	sample(paused_burn,"白盒·土",Vector2i(8,0))
	input_controls.key_down(KEY_B)
	input_controls.interrupt(true)
	input_controls.key_down(KEY_ESCAPE)
	input_controls.update(Vector2(1000,549),true,1)
	check.call(paused_burn.snapshot().alpha.burn.is_empty(), "失焦清除待点燃B意图，恢复不补发")

	var keyboard_burn: TrainingRoom = Room.new({"mode":"alpha"})
	sample(keyboard_burn,"白盒·土",Vector2i(8,0))
	var keyboard: RefCounted = load("res://scripts/input/player_controls.gd").new(keyboard_burn)
	keyboard.key_down(KEY_B)
	keyboard.update(Vector2(1000,549),true,0)
	check.call(not keyboard_burn.snapshot().alpha.burn.is_empty(), "营地真实B输入与界面点燃按钮一致")

	var shadow: TrainingRoom = Room.new({"mode":"alpha"})
	shadow.update({"alpha":{"action":"shadow","name":"司晨","quality":"异"}},0)
	check.call(shadow.snapshot().alpha.items.back().get("shadow",false), "可在出发前选择一个显式受控前局残影")

	var original_shadow: int = shadow.snapshot().alpha.shadowId
	shadow.update({"alpha":{"action":"depart"}},0)
	check.call(shadow.snapshot().alpha.camp, "未摆好残影不能出发，必须承担真实空间")
	shadow.update({"alpha":{"action":"place","id":original_shadow,"cell":Vector2i(8,0),"rotated":true}},0)
	check.call(shadow.snapshot().alpha.votes["火"]==1 and shadow.snapshot().alpha.items.back().quality=="异" and shadow.snapshot().alpha.items.back().rotated, "异品两格残影保留品质和旋转形状但基础只投1票")
	shadow.update({"alpha":{"action":"shadow","name":"素食","quality":"异"}},0)
	var inherited_id: int = shadow.snapshot().alpha.shadowId
	check.call(shadow.snapshot().alpha.items.filter(func(item: Dictionary): return item.get("shadow",false)).size()==1 and inherited_id!=original_shadow, "重新选择仍最多一件残影，不复制累积")
	shadow.update({"alpha":{"action":"place","id":inherited_id,"cell":Vector2i(6,1),"rotated":false}},0)
	check.call(shadow.snapshot().alpha.votes["木"]==2, "残影固定一票仍受真实同系气息加权")
	sample(shadow,"快马",Vector2i(7,1))
	check.call(shadow.snapshot().alpha.votes["木"]==1 and shadow.snapshot().alpha.votes["雷"]==0, "残影与实物正常正交对冲")
	shadow.update({"alpha":{"action":"depart"}},0)
	shadow.update({"alpha":{"action":"camp"}},0)
	shadow.update({"alpha":{"action":"place","id":inherited_id,"cell":Vector2i(6,2)}},0)
	check.call(shadow.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==inherited_id)[0].cell==Vector2i(6,1) and shadow.snapshot().alpha.message.contains("锁定"), "出发后即使返回营地也不能移动残影")
	shadow.update({"alpha":{"action":"use","id":inherited_id}},0)
	check.call(shadow.snapshot().alpha.message.contains("不能使用"), "残影拒绝普通物品用途，不恢复原有效果")
	shadow.update({"burn":true},0)
	check.call(shadow.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==inherited_id)[0].state=="burning", "锁定位置不禁止残影随所属容器点燃")
	shadow.update({"alpha":{"action":"depart"}},0)
	shadow.update({},20)
	check.call(shadow.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==inherited_id or item.state=="ash").is_empty() and shadow.snapshot().alpha.lostShadowIds.has(inherited_id), "残影燃后消失并记录失去实例，不产可回收灰烬")
	shadow.update({"alpha":{"action":"camp"}},0)
	var ordinary: int = sample(shadow,"素食",Vector2i(6,1))
	check.call(shadow.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==ordinary)[0].get("shadow",false)==false, "失去残影不封禁同种实物再获得")
	var none: TrainingRoom = Room.new({"mode":"alpha"})
	none.update({"alpha":{"action":"shadow","name":"司晨"}},0)
	none.update({"alpha":{"action":"shadow","name":""}},0)
	none.update({"alpha":{"action":"depart"}},0)
	check.call(not none.snapshot().alpha.camp and none.snapshot().alpha.shadowId==-1, "可主动不携带残影并正常出发")

func sample(room: TrainingRoom, title: String, cell: Vector2i, configuration: Dictionary = {}) -> int:
	var intent: Dictionary = {"action":"sample","name":title}
	intent.merge(configuration)
	room.update({"alpha":intent},0)
	var id: int = room.snapshot().alpha.items.back().id
	room.update({"alpha":{"action":"pickup","id":id}},0)
	room.update({"alpha":{"action":"place","id":id,"cell":cell,"rotated":false}},0)
	return id
