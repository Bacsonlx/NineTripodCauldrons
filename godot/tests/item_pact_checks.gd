extends RefCounted
func run(check: Callable) -> void:
	var helper = load("res://tests/item_use_checks.gd").new()
	var veggie: TrainingRoom = helper.setup()
	veggie.health=50 # 合法初始生命夹具，不改写被测结果。
	helper.act(veggie,{"action":"depart"}); veggie.update({},9.99)
	check.call(veggie.snapshot().health==50,"素食需满10秒才恢复")
	veggie.update({},0.01)
	check.call(veggie.snapshot().health==54,"素食每周期按130上限恢复3%并取整4")
	veggie.set_paused(true); veggie.update({},20)
	check.call(veggie.snapshot().health==54,"暂停不推进素食恢复周期")
	var coated: TrainingRoom = helper.setup({"enemy":{"x":455,"y":600,"appearance":"bird"},"encounter":Vector2(400,600)})
	helper.act(coated,{"action":"pickup","id":helper.id(coated,"涂炭",true)})
	helper.act(coated,{"action":"place","id":helper.id(coated,"涂炭",true),"cell":Vector2i(6,1),"rotated":true})
	helper.act(coated,{"action":"depart"}); coated.update({},0.6)
	check.call(coated.snapshot().health==82,"涂炭普通受击20×0.9最终18伤")
	var movement: TrainingRoom = helper.setup()
	helper.act(movement,{"action":"pickup","id":helper.id(movement,"涂炭",true)})
	helper.act(movement,{"action":"place","id":helper.id(movement,"涂炭",true),"cell":Vector2i(6,1),"rotated":true})
	helper.act(movement,{"action":"depart"}); movement.update({"moveX":-1},0.2)
	check.call(is_equal_approx(movement.snapshot().player.x,360.4),"涂炭在坛移动速度同时降低10%")
	var hoard: TrainingRoom = helper.setup()
	var pact: int = helper.id(hoard,"囤积",true)
	helper.act(hoard,{"action":"pickup","id":pact}); helper.act(hoard,{"action":"place","id":pact,"cell":Vector2i(6,1),"rotated":true})
	var picked: int = helper.id(hoard,"虎牙",true)
	helper.act(hoard,{"action":"pickup","id":picked}); helper.act(hoard,{"action":"depart"})
	check.call(hoard.snapshot().healthMax==131 and hoard.snapshot().health==100,"囤积首次取得新道具增加1基础生命而不补血")
	helper.act(hoard,{"action":"drop","id":picked}); helper.act(hoard,{"action":"pickup","id":picked})
	check.call(hoard.snapshot().healthMax==131,"同一实例丢下重拾不重复加囤积层")
	var burning: TrainingRoom = helper.setup()
	var book: int = helper.id(burning,"焚书",true)
	helper.act(burning,{"action":"pickup","id":book}); helper.act(burning,{"action":"place","id":book,"cell":Vector2i(6,1),"rotated":true})
	# 青龙气息下木符2票，压过火契1票；只烧木，焚书留下积累一次。
	var horn: int = helper.id(burning,"羊角",true)
	helper.act(burning,{"action":"pickup","id":horn}); helper.act(burning,{"action":"place","id":horn,"cell":Vector2i(6,2)})
	helper.act(burning,{"action":"depart"}); burning.update({"burn":true},0)
	var item: Dictionary = burning.snapshot().alpha.items.filter(func(i: Dictionary): return i.id==book)[0]
	check.call(item.get("burnStacks",0)==1 and item.state=="normal","有效原型点燃只为仍在坛的焚书记录一次")
	burning.update({"burn":true},0.1)
	check.call(burning.snapshot().alpha.items.filter(func(i: Dictionary): return i.id==book)[0].get("burnStacks",0)==1,"长按或终极未结束不重复计焚书收益")

	check.call(is_equal_approx(burning.snapshot().itemEffects.attackMultiplier,1.01),"焚书一次有效点燃只供给1%真实攻击乘数")
	burning.set_paused(true); burning.update({},30)
	check.call(is_equal_approx(burning.snapshot().itemEffects.attackMultiplier,1.01) and not burning.snapshot().alpha.burn.is_empty(),"暂停不结束燃烧也不重复发焚书收益")
	burning.set_paused(false)
	var doomed: TrainingRoom = helper.setup()
	var self_book: int = helper.id(doomed,"焚书",true)
	helper.act(doomed,{"action":"drop","id":helper.id(doomed,"素食")})
	helper.act(doomed,{"action":"pickup","id":self_book}); helper.act(doomed,{"action":"place","id":self_book,"cell":Vector2i(6,1),"rotated":true})
	helper.act(doomed,{"action":"depart"}); doomed.update({"burn":true},0)
	check.call(doomed.snapshot().alpha.items.filter(func(i: Dictionary): return i.id==self_book)[0].state=="burning" and doomed.snapshot().itemEffects.attackMultiplier==1.0,"本次点燃烧掉焚书时不留下免费攻击收益")
