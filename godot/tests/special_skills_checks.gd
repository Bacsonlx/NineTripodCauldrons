extends RefCounted
const Room = preload("res://scripts/combat/training_room.gd")
const Controls = preload("res://scripts/input/player_controls.gd")

func id(room: TrainingRoom, title: String) -> int:
	for item in room.snapshot().alpha.items:
		if item.name==title: return item.id
	return -1

func act(room: TrainingRoom, action: Dictionary) -> void:
	room.update({"alpha":action},0)

func prepare(extra: Array, options: Dictionary = {}) -> TrainingRoom:
	var configuration: Dictionary = {"mode":"gameplay","initialItems":extra.filter(func(item: Dictionary): return item.name not in ["回风","蓄势"])}
	configuration.merge(options,true)
	var room: TrainingRoom = Room.new(configuration)
	act(room,{"action":"embed","equipmentId":id(room,"训练弓"),"glyphId":id(room,"羊角")})
	act(room,{"action":"embed","equipmentId":id(room,"布履"),"glyphId":id(room,"鼠毫")})
	return room

func equip(room: TrainingRoom, title: String, cell: Vector2i, slot: int) -> int:
	var source: int = id(room,title)
	act(room,{"action":"pickup","id":source})
	act(room,{"action":"place","id":source,"cell":cell,"rotated":true})
	act(room,{"action":"assign_special","slot":slot,"sourceId":source})
	return source

func run(check: Callable) -> void:
	var room: TrainingRoom = Room.new({"mode":"gameplay"})
	check.call(id(room,"穿透箭")>=0 and id(room,"引风书")>=0 and room.snapshot().alpha.get("specialSlots",[]).size()==2,"开局专属／神兽书真实占格，特殊双槽已有箭雨")

	var mobility: TrainingRoom = Room.new({"mode":"gameplay","initialItems":[{"name":"回风"}]})
	act(mobility,{"action":"embed","equipmentId":id(mobility,"训练弓"),"glyphId":id(mobility,"羊角")})
	act(mobility,{"action":"embed","equipmentId":id(mobility,"布履"),"glyphId":id(mobility,"鼠毫")})
	var backwind: int = id(mobility,"回风")
	act(mobility,{"action":"pickup","id":backwind})
	act(mobility,{"action":"place","id":backwind,"cell":Vector2i(1,6),"rotated":true})
	act(mobility,{"action":"assign_special","slot":0,"sourceId":backwind})
	act(mobility,{"action":"depart"})
	mobility.update({"special1":true,"aim":Vector2(1000,548)},0.2)
	check.call(abs(mobility.snapshot().player.x-280)<0.01 and mobility.snapshot().dodgeInvulnerability==0 and mobility.snapshot().get("cooldowns",{}).get("backwind",0)>4.7,"无移动回风背向瞄准冲120，无无敌且记录5秒冷却")

	var charge: TrainingRoom = prepare([{"name":"蓄势"}],{"enemy":{"x":500,"y":600,"appearance":"wood"},"encounter":Vector2(400,600)})
	equip(charge,"蓄势",Vector2i(1,6),1)
	act(charge,{"action":"depart"})
	charge.update({"special2":true},0.01)
	charge.update({"fire":true,"aim":Vector2(550,548)},0.3)
	check.call(charge.snapshot().enemies[0].health==127 and charge.snapshot().get("charge",{}).get("layers",0)==1,"蓄势普通箭15×1.5最终取整23，离弦即消费一层")

	var keyboard_room: TrainingRoom = prepare([{"name":"蓄势"}])
	equip(keyboard_room,"蓄势",Vector2i(1,6),1)
	act(keyboard_room,{"action":"depart"})
	var controls: PlayerControls = Controls.new(keyboard_room)
	controls.key_down(KEY_G); controls.key_up(KEY_G)
	controls.update(Vector2(900,548),true,0.01)
	check.call(keyboard_room.snapshot().charge.layers==2,"G短按脉冲对应第二特殊槽，不被同帧松键吞掉")

	var space: TrainingRoom = prepare([{"name":"回风"},{"name":"蓄势"}])
	var wind_id: int = equip(space,"回风",Vector2i(1,6),0)
	var charge_id: int = equip(space,"蓄势",Vector2i(3,6),1)
	check.call(space.snapshot().alpha.specialSlots[0].active and space.snapshot().alpha.specialSlots[1].active and space.snapshot().alpha.skillSources.size()==3,"两轻书连同专属神兽占9格，第三本箭雨持有但不自动启用")
	act(space,{"action":"place","id":id(space,"穿透箭"),"cell":Vector2i(6,0)})
	check.call(space.snapshot().alpha.message.contains("经脉"),"专属书不可卸出经脉")
	act(space,{"action":"embed_book","equipmentId":id(space,"布履"),"bookId":id(space,"引风书")})
	check.call(space.snapshot().alpha.message.contains("特殊"),"神兽书不能镶嵌装备")
	act(space,{"action":"embed_book","equipmentId":id(space,"训练弓"),"bookId":wind_id})
	check.call(id(space,"回风")==wind_id and space.snapshot().alpha.message.contains("最多一本"),"已镶箭雨的弓拒绝第二本并保留回风实物")
	act(space,{"action":"embed_book","equipmentId":id(space,"布履"),"bookId":wind_id})
	check.call(id(space,"回风")==-1 and space.snapshot().alpha.specialSlots[0].active and space.snapshot().alpha.specialSlots[0].sourceId==wind_id,"镶嵌移动原书实例而不复制，原选择来源标识仍有效")
	act(space,{"action":"depart"})
	space.update({"special1":true,"moveX":1},0.05)
	var remaining: float = space.snapshot().cooldowns.backwind
	act(space,{"action":"camp"})
	act(space,{"action":"place","id":id(space,"布履"),"cell":Vector2i(6,0)})
	check.call(not space.snapshot().alpha.specialSlots[0].active and space.snapshot().alpha.specialSlots[1].sourceId==charge_id,"嵌书装备上坛使指定槽空缺，不自动切到第三书")
	space.update({},10)
	check.call(space.snapshot().cooldowns.backwind==remaining,"营地试摆不推进或清零技能冷却")
	act(space,{"action":"place","id":id(space,"布履"),"cell":Vector2i(3,0)})
	check.call(space.snapshot().alpha.specialSlots[0].active and space.snapshot().cooldowns.backwind==remaining,"原装备来源恢复时技能恢复，冷却仍按技能名保留")
	var blocked: TrainingRoom = prepare([{"name":"回风"}],{"obstacle":Rect2(413,580,20,40)})
	equip(blocked,"回风",Vector2i(1,6),0)
	act(blocked,{"action":"depart"})
	blocked.update({"special1":true,"moveX":1},0.2)
	check.call(blocked.snapshot().player.x==400 and blocked.snapshot().cooldowns.backwind==0,"回风完全受阻拒绝且不扣冷却")
	var partial: TrainingRoom = prepare([{"name":"回风"}],{"obstacle":Rect2(460,580,20,40)})
	equip(partial,"回风",Vector2i(1,6),0)
	act(partial,{"action":"depart"})
	partial.update({"special1":true,"moveX":1},0.2)
	check.call(partial.snapshot().player.x<=448 and partial.snapshot().player.x>400 and partial.snapshot().cooldowns.backwind>4.7,"回风按路径分段受实体阻断，部分位移支付一次")
	var air: TrainingRoom = prepare([{"name":"蓄势"}])
	equip(air,"蓄势",Vector2i(1,6),1)
	act(air,{"action":"depart"})
	air.update({"special2":true},0.01)
	air.update({"fire":true,"aim":Vector2(200,548)},0.1)
	check.call(air.snapshot().charge.layers==1,"蓄势射空也在离弦时消层")
	air.update({},0.3)
	air.update({"pierce":true,"aim":Vector2(200,548)},0.3)
	check.call(air.snapshot().charge.layers==1,"穿透箭不消费也不获得普通箭蓄势层")
	air.update({},4)
	check.call(air.snapshot().charge.layers==0,"蓄势四秒到期清除剩层")
	var cancel: TrainingRoom = prepare([{"name":"回风"}])
	equip(cancel,"回风",Vector2i(1,6),0)
	act(cancel,{"action":"depart"})
	var canceled_controls: PlayerControls = Controls.new(cancel)
	canceled_controls.key_down(KEY_E)
	canceled_controls.interrupt(true); canceled_controls.key_down(KEY_ESCAPE)
	canceled_controls.update(Vector2(900,548),true,0.2)
	check.call(cancel.snapshot().player.x==400 and cancel.snapshot().cooldowns.backwind==0,"失焦清除E槽待发意图，恢复不补发回风")
	canceled_controls.key_down(KEY_D); canceled_controls.key_down(KEY_E)
	canceled_controls.update(Vector2(900,548),true,0.05)
	var stopped: float = cancel.snapshot().player.x
	canceled_controls.interrupt(true); canceled_controls.key_down(KEY_ESCAPE)
	canceled_controls.update(Vector2(900,548),true,0.3)
	check.call(cancel.snapshot().player.x==stopped and cancel.snapshot().skillDash.remaining==0,"暂停中断已开始的回风，回焦不自动续冲")

	var heavy: TrainingRoom = prepare([{"name":"箭雨"}])
	var loose_rain: int = id(heavy,"箭雨")
	act(heavy,{"action":"depart"})
	heavy.update({},0.01)
	act(heavy,{"action":"quick_altar"})
	act(heavy,{"action":"camp"})
	act(heavy,{"action":"place","id":id(heavy,"穿透箭"),"cell":Vector2i(0,6),"rotated":true})
	act(heavy,{"action":"place","id":id(heavy,"引风书"),"cell":Vector2i(0,5),"rotated":true})
	act(heavy,{"action":"place","id":loose_rain,"cell":Vector2i(3,5),"rotated":false})
	check.call(heavy.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==loose_rain)[0].region=="meridian","旋转专属与神兽书后，箭雨与固定两书可真实摆入9格")
	act(heavy,{"action":"pickup","id":id(heavy,"回风")})
	var heavy_wind: int = id(heavy,"回风")
	act(heavy,{"action":"place","id":heavy_wind,"cell":Vector2i(2,6),"rotated":true})
	check.call(heavy.snapshot().alpha.items.filter(func(item: Dictionary): return item.id==heavy_wind)[0].region=="warehouse","箭雨加轻书共11格放置失败，原实物留仓不覆盖")
	act(heavy,{"action":"embed_book","equipmentId":id(heavy,"布履"),"bookId":heavy_wind})
	act(heavy,{"action":"assign_special","slot":1,"sourceId":heavy_wind})
	check.call(heavy.snapshot().alpha.specialSlots[1].active and id(heavy,"回风")==-1,"把轻书镶入布履后解决11格冲突并启用G")
